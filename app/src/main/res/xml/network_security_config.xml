<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 默认禁止明文流量，只信任系统证书 -->
    <base-config cleartextTrafficPermitted="false"
                 usesCleartextTraffic="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- 登录认证与核心 API 严禁使用明文 HTTP -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">bilibili.com</domain>
        <domain includeSubdomains="true">bilibili.tv</domain>
        <domain includeSubdomains="true">biliapi.net</domain>
    </domain-config>

    <!-- 仅对 B 站 CDN 域名放行明文（部分老旧 CDN 节点不支持 HTTPS） -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">bilivideo.com</domain>
        <domain includeSubdomains="true">bilivideo.cn</domain>
        <domain includeSubdomains="true">hdslb.com</domain>
    </domain-config>

    <!-- 调试模式下信任用户安装的证书（如抓包工具） -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
